  "narrative": {
    "northStar": "A Place at the Garden Table",
    "overview": "A warm, spacious garden invitation pairs expressive serif lettering with plainly readable controls. Parchment and olive establish the atmosphere; clay provides a human, sun-warmed accent. One panoramic tablescape supplies photographic richness while hairline rules organize the practical details.\n\nThis system belongs only to the fictional Olive & Theo portfolio sample. It records the implemented world rather than prescribing a theme for other invitations. The staged reply feels like a small sheet of correspondence, with a simple one-step reply.",
    "keyCharacteristics": [
      "Generous parchment space and an olive countdown.",
      "Expressive serif headings with restrained italic clay accents.",
      "A rounded photographic canopy and circular date seal.",
      "Plain tactile form controls and one-step reply submission."
    ],
    "rules": [
      {
        "name": "The Garden Contrast Rule",
        "body": "Use olive for large dark surfaces and primary actions; use clay for emphasis and focus. Preserve the warm neutral reading surfaces around both.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Keep expressive serif lettering in names, headings, and short sentiments; keep instructions, labels, and form values in Inter.",
        "section": "typography"
      },
      {
        "name": "The Correspondence Rule",
        "body": "Reserve the observed soft shadow for the reply sheet; keep the information sections organized by space and rules.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the scoped garden palette, existing font resources, and clear serif/sans role split.",
      "Do keep primary actions visible and use the established clay focus treatment.",
      "Do retain opaque backing throughout the cover's foreground exit, then reveal the destination underneath it.",
      "Do preserve reduced motion, focus transfer, semantic form controls.",
      "Do use space and hairline rules to organize practical information."
    ],
    "donts": [
      "Don't apply this invitation's palette or silhouettes to unrelated clients.",
      "Don't use expressive serif lettering for field values or long instructions.",
      "Don't make all information blocks into elevated cards.",
      "Don't imply that the in-memory demonstration persists a reply."
    ]
  }
