  "narrative": {
    "northStar": "Enchanted Floral Stationery",
    "overview": "This client invitation combines supplied floral frames, classical columns, champagne damask, a blush envelope, and parchment story sheets. Its warmth comes from physical stationery artwork, expressive script, and restrained text controls.\n\nThe implementation presents one invitation page at a time inside a fixed viewport. This document records the current client implementation; it does not prescribe a theme for other invitations.",
    "keyCharacteristics": [
      "Floral artwork and paper textures frame readable content.",
      "Script names and headings pair with a steady serif reading face.",
      "Cream, dusty blue, and blush distinguish chapter surfaces.",
      "Persistent navigation supports a presentation rather than a scrolling page."
    ],
    "rules": [
      {
        "name": "The Paper and Ink Rule",
        "body": "Preserve warm ink on pale stationery surfaces for essential event information; decorative artwork frames that information.",
        "section": "colors"
      },
      {
        "name": "The Reading Face Rule",
        "body": "Keep long passages and essential field instructions in readable serif or sans text; reserve script for names, short messages, and headings.",
        "section": "typography"
      },
      {
        "name": "The One Page Rule",
        "body": "Paginate dense entourage material. Keep the full story on one internally scrolling chapter with photo and framed title.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do keep client artwork, fonts, tokens, and styling scoped to this invitation.",
      "Do preserve transparent artwork edges and reserve their inner areas for text.",
      "Do paginate dense material while retaining persistent navigation.",
      "Do keep preview and missing-photo status explicit.",
      "Do retain keyboard, focus, touch, and reduced-motion behavior."
    ],
    "donts": [
      "Don't use script for long passages or form instructions.",
      "Don't introduce scrolling into this confirmed presentation experience.",
      "Don't represent preview replies as persisted RSVPs.",
      "Don't treat pending photographs, audio, or backend setup as completed design evidence."
    ]
  }
